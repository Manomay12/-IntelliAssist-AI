# Streamlit Community Cloud Secrets Configuration Example
# When deploying to https://share.streamlit.io:
# Go to App Settings -> Secrets, and paste your API keys:

GEMINI_API_KEY = "your-google-gemini-api-key-here"
NVIDIA_API_KEY = "your-nvidia-nim-api-key-here"
OPENAI_API_KEY = ""
DEFAULT_LLM_PROVIDER = "Google Gemini"
